{
  "name": "xalpheric-neocities",
  "version": "1.0.0",
  "description": "Static site builder for Thoughts & Musings section using Node.js",
  "main": "build-musings.js",
  "bin": {
    "neocities": "./cli/index.js"
  },
  "scripts": {
    "build": "node cli/index.js build musings",
    "build:all": "node cli/index.js build all",
    "media:sync": "node cli/index.js media sync-images",
    "build-musings": "echo '⚠️  DEPRECATED: Use npm run build' && node build-musings.js",
    "process-blog-photos": "./process-photos-enhanced.sh blog 512 jpg",
    "process-asset-photos": "./process-photos-enhanced.sh assets 512 jpg",
    "sync-obsidian-images": "echo '⚠️  DEPRECATED: Use npm run media:sync' && node sync-obsidian-images.js",
    "obsidian-to-blog": "echo '⚠️  DEPRECATED: Use npm run build:all' && node obsidian-to-blog.js",
    "deploy": "node cli/index.js deploy musings",
    "deploy-full": "node cli/index.js deploy full",
    "deploy-music": "node cli/index.js deploy music",
    "deploy-config": "node cli/index.js deploy config",
    "deploy-recent": "node cli/index.js deploy recent",
    "process-photos": "node process-photos.js",
    "process-video": "node process-video.js",
    "watch-photos": "./watch-photos.sh",
    "watch-photos-simple": "node watch-photos-applescript.js",
    "watch-photos-advanced": "node watch-photos.js",
    "watch-videos": "node watch-videos.js",
    "test-photo-watcher": "node test-photo-watcher.js",
    "check-deps": "node check-deps.js",
    "serve": "http-server public -p 8080",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "author": "Jason Belcher",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "dotenv": "^17.2.0",
    "form-data": "^4.0.0",
    "markdown-it": "^13.0.1",
    "marked": "^10.0.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "http-server": "^14.1.1",
    "jest": "^30.2.0"
  }
}
