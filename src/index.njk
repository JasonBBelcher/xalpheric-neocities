<!-- 03 RELEASES SECTION -->
<section class="section" id="releases" style="background: var(--bg-base);">
  <div class="container">
    <p class="section__eyebrow">03 · RELEASES</p>

    <details class="catalog-details">
      <summary class="catalog-summary">
        <h2 class="section__title" style="margin:0;">Catalog</h2>
        <span class="catalog-chevron" aria-hidden="true">▾</span>
      </summary>

      <!-- Release strips — entire row is the download link -->
      {% for release in releases %}
      <a href="{{ release.audio }}" class="release-strip" download>
        <span class="release-strip__num">XAL·{{ loop.index0 | zeroPad }}</span>
        <div>
          <div class="release-strip__title">{{ release.title }}</div>
          <div class="release-strip__meta">{{ release.duration }} · {{ release.year }}</div>
        </div>
        <span class="release-strip__action">Download</span>
      </a>
      {% endfor %}
    </details>

    <!-- Player carousel -->
    <div style="margin-top: var(--space-block);">
      <p class="section__eyebrow" style="margin-bottom: 1rem;">PLAYER</p>
      <section class="release-carousel">
        <div class="release-viewer">
          <img id="cover" src="" class="cover-art" alt="Album cover" />
          <div id="title" style="font-family: var(--font-display); font-size: var(--type-h3); font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-primary); margin: 0.5rem 0;"></div>
          <div id="description" style="font-family: var(--font-body); font-size: var(--type-caption); color: var(--text-secondary); font-style: italic; max-width: 36ch; text-align: center; line-height: 1.6;"></div>
          <div style="font-family: var(--font-data); font-size: var(--type-caption); color: var(--text-faint); letter-spacing: 0.1em; margin: 0.25rem 0; display: flex; gap: 1rem; justify-content: center;">
            <span id="year"></span>
            <span id="duration"></span>
            <span id="track-counter"></span>
          </div>
          <audio id="player" controls></audio>
          <a id="download" href="#" download class="download">Download</a>
          <span id="loading" style="display:none; font-family: var(--font-data); font-size: var(--type-caption); color: var(--text-secondary);">Loading...</span>
          <span id="error-message" style="display:none; color: var(--accent-red); font-family: var(--font-data); font-size: var(--type-caption);"></span>
        </div>
        <div class="carousel-nav">
          <button class="nav left">PREV</button>
          <button class="nav right">NEXT</button>
        </div>
      </section>
    </div>
  </div>
</section>

<!-- 04 COLLECTIVE SECTION -->
<section class="section section--dark" id="collective">
  <div class="container">
    <p class="section__eyebrow" style="color: var(--accent-cold);">04 · COLLECTIVE</p>
    <h2 class="section__title section__title--cold">MIDI Mob</h2>
    <p class="section__body">
      MIDI Mob Collective is a Birmingham-based music community bringing together producers,
      musicians, and sonic experimenters. Spanning genres from psytrance to folk, ambient to
      experimental rock, the collective is united by a love of hardware, vinyl, and the creative process.
    </p>
    <div class="members-grid" style="margin-top: var(--space-block);">
      <!-- Member card 1: Gone -->
