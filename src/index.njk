        </div>
      </div>
      <!-- Member card 2: Future Primitives -->
      <div class="member-card">
        <div class="member-card__media">
          <iframe width="100%" height="100%" src="https://www.youtube.com/embed/McpFOjksrKI" title="Future Primitives" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
        </div>
        <div class="member-card__info">
