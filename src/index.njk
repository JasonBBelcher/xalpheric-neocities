        <div class="member-card__media">
          <iframe width="100%" height="100%" src="https://www.youtube.com/embed/QmhxgTx6cmA" title="Gone - Folktronic Ambient" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
        </div>
        <div class="member-card__info">
          <h3 class="member-card__name">Gone</h3>
          <p class="member-card__role">Folktronic Ambient</p>
