<div class="member-card">
  {% if member.youtubeId %}
  <div class="member-card__media">
    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/{{ member.youtubeId }}" title="{{ member.name }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
  </div>
  {% elif member.soundcloudUrl %}
  <div class="member-card__media member-card__media--soundcloud">
    <iframe width="100%" height="166" scrolling="no" frameborder="no" allow="autoplay" src="{{ member.soundcloudUrl }}" loading="lazy"></iframe>
  </div>
  {% endif %}
  <div class="member-card__info">
    <h3 class="member-card__name">{{ member.name }}</h3>
    <p class="member-card__role">{{ member.role }}</p>
    <p class="member-card__bio">{{ member.bio }}</p>
    {% if member.links and member.links.length %}
    <div class="member-card__links">
      {% for link in member.links %}
      <a href="{{ link.url }}" {% if '://' in link.url %}target="_blank" rel="noopener"{% endif %} class="member-card__link">{{ link.label }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
