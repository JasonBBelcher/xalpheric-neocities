<section class="hero">
  <div class="hero__starmap" aria-hidden="true">
    <svg viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg">
      <!-- Star field -->
      <circle cx="42" cy="28" r="1" fill="#c47a2a"/>
      <circle cx="120" cy="67" r="0.7" fill="#e4d9bc"/>
      <circle cx="200" cy="22" r="1.2" fill="#e4d9bc"/>
      <circle cx="310" cy="89" r="0.5" fill="#2a8a9c"/>
      <circle cx="380" cy="34" r="1" fill="#e4d9bc"/>
      <circle cx="450" cy="78" r="0.7" fill="#c47a2a"/>
      <circle cx="520" cy="15" r="1.2" fill="#e4d9bc"/>
      <circle cx="600" cy="56" r="0.5" fill="#e4d9bc"/>
      <circle cx="680" cy="33" r="1" fill="#2a8a9c"/>
      <circle cx="740" cy="88" r="0.7" fill="#e4d9bc"/>
      <circle cx="78" cy="140" r="0.5" fill="#e4d9bc"/>
      <circle cx="160" cy="180" r="1" fill="#c47a2a"/>
      <circle cx="240" cy="155" r="0.7" fill="#e4d9bc"/>
      <circle cx="340" cy="200" r="1.5" fill="#c47a2a"/>
      <circle cx="420" cy="145" r="0.5" fill="#e4d9bc"/>
      <circle cx="490" cy="190" r="1" fill="#e4d9bc"/>
      <circle cx="570" cy="130" r="0.7" fill="#2a8a9c"/>
      <circle cx="650" cy="175" r="0.5" fill="#e4d9bc"/>
      <circle cx="720" cy="210" r="1.2" fill="#c47a2a"/>
      <circle cx="100" cy="280" r="0.8" fill="#e4d9bc"/>
      <circle cx="280" cy="310" r="1" fill="#c47a2a"/>
      <circle cx="500" cy="290" r="0.6" fill="#e4d9bc"/>
      <circle cx="660" cy="330" r="1.1" fill="#2a8a9c"/>
      <!-- Constellation lines -->
      <line x1="42" y1="28" x2="120" y2="67" stroke="#c47a2a" stroke-width="0.4" opacity="0.6"/>
      <line x1="120" y1="67" x2="200" y2="22" stroke="#c47a2a" stroke-width="0.4" opacity="0.6"/>
      <line x1="380" y1="34" x2="450" y2="78" stroke="#2a8a9c" stroke-width="0.4" opacity="0.6"/>
      <line x1="450" y1="78" x2="520" y2="15" stroke="#2a8a9c" stroke-width="0.4" opacity="0.6"/>
      <line x1="160" y1="180" x2="240" y2="155" stroke="#c47a2a" stroke-width="0.4" opacity="0.6"/>
      <line x1="240" y1="155" x2="340" y2="200" stroke="#c47a2a" stroke-width="0.4" opacity="0.6"/>
      <!-- Coordinate grid -->
      <line x1="0" y1="133" x2="800" y2="133" stroke="#2a8a9c" stroke-width="0.3" opacity="0.3"/>
      <line x1="0" y1="266" x2="800" y2="266" stroke="#2a8a9c" stroke-width="0.3" opacity="0.3"/>
      <line x1="200" y1="0" x2="200" y2="400" stroke="#2a8a9c" stroke-width="0.3" opacity="0.3"/>
      <line x1="400" y1="0" x2="400" y2="400" stroke="#2a8a9c" stroke-width="0.3" opacity="0.3"/>
      <line x1="600" y1="0" x2="600" y2="400" stroke="#2a8a9c" stroke-width="0.3" opacity="0.3"/>
      <!-- Target reticle -->
      <circle cx="340" cy="200" r="12" stroke="#c47a2a" stroke-width="0.5" fill="none"/>
      <circle cx="340" cy="200" r="20" stroke="#c47a2a" stroke-width="0.3" fill="none" stroke-dasharray="3 3"/>
      <line x1="328" y1="200" x2="316" y2="200" stroke="#c47a2a" stroke-width="0.5"/>
      <line x1="352" y1="200" x2="364" y2="200" stroke="#c47a2a" stroke-width="0.5"/>
      <line x1="340" y1="188" x2="340" y2="176" stroke="#c47a2a" stroke-width="0.5"/>
      <line x1="340" y1="212" x2="340" y2="224" stroke="#c47a2a" stroke-width="0.5"/>
    </svg>
  </div>

  <svg class="hero__vinyl" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="200" cy="200" r="198" stroke="#c47a2a" stroke-width="1"/>
    <circle cx="200" cy="200" r="180" stroke="#c47a2a" stroke-width="0.5"/>
    <circle cx="200" cy="200" r="160" stroke="#c47a2a" stroke-width="0.5"/>
    <circle cx="200" cy="200" r="140" stroke="#c47a2a" stroke-width="0.5"/>
    <circle cx="200" cy="200" r="120" stroke="#c47a2a" stroke-width="1"/>
    <circle cx="200" cy="200" r="100" stroke="#c47a2a" stroke-width="0.5"/>
    <circle cx="200" cy="200" r="80" stroke="#c47a2a" stroke-width="0.5"/>
    <circle cx="200" cy="200" r="60" stroke="#c47a2a" stroke-width="0.5"/>
    <circle cx="200" cy="200" r="40" stroke="#c47a2a" stroke-width="1"/>
    <circle cx="200" cy="200" r="20" stroke="#c47a2a" stroke-width="0.5"/>
    <circle cx="200" cy="200" r="8" fill="#c47a2a"/>
    <circle cx="200" cy="200" r="170" stroke="#c47a2a" stroke-width="0.3" stroke-dasharray="2 3"/>
    <circle cx="200" cy="200" r="150" stroke="#c47a2a" stroke-width="0.3" stroke-dasharray="2 3"/>
    <circle cx="200" cy="200" r="130" stroke="#c47a2a" stroke-width="0.3" stroke-dasharray="2 3"/>
  </svg>

  <div class="container">
    <div class="hero__content">
      <p class="hero__eyebrow">{{eyebrow}}</p>
      <h1 class="hero__title">{{title}}<strong>{{titleStrong}}</strong></h1>
      <p class="hero__sub">{{sub}}</p>
    </div>
  </div>
</section>
