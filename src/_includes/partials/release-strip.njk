<div class="release-strip">
  <span class="release-strip__num">XAL·{{ index | zeroPad }}</span>
  <div>
    <div class="release-strip__title">{{ title }}</div>
    <div class="release-strip__meta">{{ duration }} · {{ year }}</div>
  </div>
  <a href="{{ audio }}" class="release-strip__action" download>Download</a>
</div>
