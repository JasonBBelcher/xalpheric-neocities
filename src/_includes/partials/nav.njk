          <li><a href="/gallery.html" class="site-nav__link{% if navGallery %} site-nav__link--active{% endif %}" {% if navGallery %}aria-current="page"{% endif %}>Gallery</a></li>
          <li><a href="/collective.html" class="site-nav__link{% if navCollective %} site-nav__link--active{% endif %}" {% if navCollective %}aria-current="page"{% endif %}>Collective</a></li>
          <li><a href="/musings.html" class="site-nav__link{% if navMusings %} site-nav__link--active{% endif %}" {% if navMusings %}aria-current="page"{% endif %}>Musings</a></li>
