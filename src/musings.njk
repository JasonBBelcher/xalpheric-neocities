<section class="section" style="background: var(--bg-base);">
  <div class="container">
    <div id="musings-list" style="display: grid; gap: 1.5rem;">
      <!-- Posts loaded via jQuery from musings/index.html -->
      <p style="font-family: var(--font-data); font-size: var(--type-caption); color: var(--text-faint); letter-spacing: 0.1em;">
        LOADING...
      </p>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  fetch('/musings/index.html')
    .then(function(r) { return r.ok ? r.text() : Promise.reject(); })
    .then(function(html) { document.getElementById('musings-list').innerHTML = html; })
    .catch(function() {
      document.getElementById('musings-list').innerHTML =
        '<p style="font-family: var(--font-body); color: var(--text-secondary);">No musings available yet. Check back soon.</p>';
    });
});
</script>
